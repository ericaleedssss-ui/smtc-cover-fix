 // wheelAnimation is how the notches of a mouse wheel scroll: along a short
 // ease out, as browsers scroll them, rather than the whole notch at once.
 var wheelAnimation = Animation{Duration: 150 * time.Millisecond, Ease: EaseOut}
+
+// retargetWheel carries the velocity of a moving axis into a cubic Hermite
+// curve that ends at rest. A normalized slope of at most three keeps the
+// curve monotone, even when a notch brings the target much closer.
+func retargetWheel(ch *channel, delta float32) {
+	target := ch.target + float64(delta)
+	if !ch.moving {
+		ch.retarget(target, wheelAnimation)
+		return
+	}
+	distance := target - ch.value
+	if distance == 0 {
+		ch.target, ch.velocity, ch.moving = target, 0, false
+		return
+	}
+	duration := wheelAnimation.Duration
+	velocity := ch.velocity
+	if velocity*distance < 0 {
+		velocity = 0 // a reversal starts toward the new target
+	}
+	ch.velocity = velocity
+	if math.Abs(velocity)*duration.Seconds() > 3*math.Abs(distance) {
+		limit := 3 * math.Abs(distance/velocity)
+		duration = max(time.Nanosecond, time.Duration(limit*float64(time.Second)))
+	}
+	slope := float32(min(3, velocity*duration.Seconds()/distance))
+	ch.retarget(target, Animation{Duration: duration, Ease: func(t float32) float32 {
+		return t * (slope + t*(3-2*slope+t*(slope-2)))
+	}})
+}
 
