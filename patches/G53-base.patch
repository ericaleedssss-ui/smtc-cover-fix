@@ -0,0 +1,169 @@
+import QtQuick
+import QtQuick.Window
+import QtQuick.Controls as Controls
+
+Item {
+    id: navigation
+    objectName: "sideNavigationRoot"
+    required property Item background
+    property real unit: 1
+    property bool expanded: false
+    readonly property bool home: rhine.state.mode === "archive" && !rhine.state.modal && !rhine.state.directoryOpen && !rhine.state.lyricsMode && !rhine.state.viewer
+    readonly property real typeUnit: Math.max(.9, unit)
+    readonly property real railWidth: 54 * typeUnit
+    property bool musicOpen: true
+    property bool createdOpen: true
+    property bool collectedOpen: true
+    property string selected: ""
+    property real drawerWidth: Math.max(208, 246 * unit)
+    property real drawerHeight: Math.min(height - 340 * unit, 720 * unit)
+    property real drawerY: Math.max(210 * unit, (height - 100 * unit - drawerHeight) / 2)
+
+    function open() {
+        closeTimer.stop();
+        if (!expanded) rhine.action("navigation:load-playlists");
+        expanded = true;
+    }
+    function scheduleClose() { closeTimer.restart(); }
+    function discover(tab) {
+        rhine.action("discover");
+        rhine.action("discover:tab:" + tab);
+        selected = tab;
+        scheduleClose();
+    }
+    function profile(filter) {
+        var uid = rhine.state.accountUID || "";
+        if (!uid) { rhine.action("saved"); scheduleClose(); return; }
+        rhine.action("profile:open:" + uid);
+        if (filter) rhine.action("profile:filter:" + filter);
+        selected = "profile:" + filter;
+        scheduleClose();
+    }
+
+    Timer {
+        id: closeTimer; interval: 280
+        onTriggered: if (!edgeHover.hovered && !panelHover.hovered) navigation.expanded = false
+    }
+    Item {
+        x: 0; y: navigation.drawerY
+        width: Math.max(18, 26 * navigation.unit); height: navigation.drawerHeight
+        HoverHandler {
+            id: edgeHover
+            onHoveredChanged: hovered ? navigation.open() : navigation.scheduleClose()
+        }
+    }
+    Item {
+        id: drawer
+        objectName: "sideNavigation"
+        x: navigation.expanded || navigation.home ? 18 * navigation.unit : -width - 8 * navigation.unit
+        y: navigation.expanded ? navigation.drawerY : (navigation.height - 100 * navigation.unit - height) / 2
+        width: navigation.expanded ? navigation.drawerWidth : navigation.railWidth
+        height: navigation.expanded ? navigation.drawerHeight : 164 * navigation.typeUnit
+        Behavior on x { NumberAnimation { duration: 230; easing.type: Easing.OutCubic } }
+        Behavior on y { NumberAnimation { duration: 230; easing.type: Easing.OutCubic } }
+        Behavior on width { NumberAnimation { duration: 230; easing.type: Easing.OutCubic } }
+        Behavior on height { NumberAnimation { duration: 230; easing.type: Easing.OutCubic } }
+        HoverHandler {
+            id: panelHover
+            onHoveredChanged: hovered ? navigation.open() : navigation.scheduleClose()
+        }
+        LiquidGlass {
+            anchors.fill: parent
+            background: navigation.background
+            sampleX: drawer.x; sampleY: drawer.y
+            uiScale: navigation.unit; dark: rhine.state.dark === true
+        }
+        Column {
+            anchors.centerIn: parent; spacing: 4 * navigation.typeUnit
+            opacity: navigation.expanded ? 0 : 1
+            visible: opacity > .01; enabled: !navigation.expanded && navigation.home
+            Behavior on opacity { NumberAnimation { duration: 100 } }
+            Repeater {
+                model: [{icon:"✧", label:"精选", action:"discover"}, {icon:"♡", label:"我喜欢的音乐", action:"navigation:likes"}, {icon:"◯", label:"我的主页", action:"profile"}]
+                delegate: Rectangle {
+                    required property var modelData
+                    width: 42 * navigation.typeUnit; height: width; radius: 12 * navigation.typeUnit
+                    color: railMouse.containsMouse ? "#20a2aa8d" : "transparent"
+                    Text { anchors.centerIn: parent; text: modelData.icon; font.pixelSize: 22 * navigation.typeUnit; color: rhine.state.dark ? "#eeeee8" : "#43473d" }
+                    Controls.ToolTip.visible: railMouse.containsMouse
+                    Controls.ToolTip.text: modelData.label
+                    Controls.ToolTip.delay: 500
+                    MouseArea { id: railMouse; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor
+                        onClicked: { if (modelData.action === "profile") navigation.profile(""); else rhine.action(modelData.action); }
+                    }
+                }
+            }
+        }
+        Flickable {
+            id: list
+            anchors.fill: parent; anchors.margins: 12 * navigation.unit
+            opacity: navigation.expanded ? 1 : 0
+            visible: opacity > .01; enabled: navigation.expanded
+            Behavior on opacity { NumberAnimation { duration: 140 } }
+            clip: true; contentWidth: width; contentHeight: content.implicitHeight
+            boundsBehavior: Flickable.StopAtBounds
+            Column {
+                id: content
+                width: list.width; spacing: 2 * navigation.unit
+                Text { text: "发现音乐"; font.pixelSize: 15 * navigation.typeUnit; font.bold: true; color: rhine.state.dark ? "#d8dad1" : "#5b5d55"; height: 32 * navigation.unit; verticalAlignment: Text.AlignVCenter }
+                Repeater {
+                    model: [{label:"推荐", icon:"◈", tab:"daily"}, {label:"精选", icon:"✧", tab:"playlists"}, {label:"排行榜", icon:"≡", tab:"charts"}, {label:"新专辑", icon:"◉", tab:"albums"}]
+                    delegate: NavRow {
+                        required property var modelData
+                        label: modelData.label; icon: modelData.icon
+                        selected: navigation.selected === modelData.tab
+                        onInvoked: navigation.discover(modelData.tab)
+                    }
+                }
+                NavRow { label: navigation.musicOpen ? "我的音乐  ﹀" : "我的音乐  ›"; icon: "♡"; onInvoked: navigation.musicOpen = !navigation.musicOpen }
+                NavRow { visible: navigation.musicOpen; label: "我喜欢的音乐"; icon: "♡"; selected: navigation.selected === "likes"; onInvoked: { navigation.selected = "likes"; rhine.action("navigation:likes"); navigation.scheduleClose(); } }
+                NavRow { visible: navigation.musicOpen; label: "我的主页"; icon: "◯"; selected: navigation.selected === "profile:"; onInvoked: navigation.profile("") }
+                NavRow { visible: navigation.musicOpen; label: "最近播放"; icon: "◷"; selected: navigation.selected === "profile:recent"; onInvoked: navigation.profile("recent") }
+                NavRow { visible: navigation.musicOpen; label: "我的收藏"; icon: "☆"; selected: navigation.selected === "profile:collected"; onInvoked: navigation.profile("collected") }
+                NavRow { label: navigation.createdOpen ? "创建的歌单  ﹀" : "创建的歌单  ›"; icon: "♫"; onInvoked: navigation.createdOpen = !navigation.createdOpen }
+                Repeater {
+                    model: navigation.createdOpen ? (rhine.state.navigationCreated || []) : []
+                    delegate: PlaylistRow { required property var modelData; required property int index; entry: modelData; lane: 2; itemIndex: index }
+                }
+                NavRow { label: navigation.collectedOpen ? "收藏的歌单  ﹀" : "收藏的歌单  ›"; icon: "☆"; onInvoked: navigation.collectedOpen = !navigation.collectedOpen }
+                Repeater {
+                    model: navigation.collectedOpen ? (rhine.state.navigationCollected || []) : []
+                    delegate: PlaylistRow { required property var modelData; required property int index; entry: modelData; lane: 3; itemIndex: index }
+                }
+            }
+        }
+    }
+    component PlaylistRow: Item {
+        id: playlist
+        property var entry: ({})
+        property int lane: 2
+        property int itemIndex: 0
+        width: list.width; height: 59 * navigation.typeUnit
+        opacity: Math.max(0, Math.min(1, (y - list.contentY + height) / (24 * navigation.unit), (list.height - (y - list.contentY)) / (24 * navigation.unit)))
+        Rectangle { anchors.fill: parent; radius: 8 * navigation.unit; color: rhine.state.dark ? "#929b83" : "#a2aa8d"; opacity: playlistMouse.containsMouse ? 0.18 : 0; Behavior on opacity { NumberAnimation { duration: 110 } } }
+        Image { x: 8 * navigation.unit; anchors.verticalCenter: parent.verticalCenter; width: 36 * navigation.typeUnit; height: width; source: String(playlist.entry.cover || "").replace(/^http:/, "https:"); sourceSize.width: 100; sourceSize.height: 100; fillMode: Image.PreserveAspectCrop; asynchronous: true }
+        Text { x: 49 * navigation.typeUnit; width: parent.width - x - 8 * navigation.unit; anchors.verticalCenter: parent.verticalCenter; text: playlist.entry.title || "歌单"; font.pixelSize: 15 * navigation.typeUnit; wrapMode: Text.Wrap; maximumLineCount: 2; elide: Text.ElideRight; color: rhine.state.dark ? "#eeeee8" : "#30342d" }
+        Controls.ToolTip.visible: playlistMouse.containsMouse
+        Controls.ToolTip.text: playlist.entry.title || "歌单"
+        Controls.ToolTip.delay: 650
+        MouseArea { id: playlistMouse; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: { rhine.action("navigation:playlist:" + playlist.lane + ":" + playlist.itemIndex); navigation.scheduleClose(); } }
+    }
+    component NavRow: Item {
+        id: row
+        property string label: ""
+        property string icon: ""
+        property bool selected: false
+        signal invoked()
+        width: list.width; height: visible ? 43 * navigation.typeUnit : 0
+        opacity: Math.max(0, Math.min(1, (y - list.contentY + height) / (24 * navigation.unit), (list.height - (y - list.contentY)) / (24 * navigation.unit)))
+        Rectangle {
+            anchors.fill: parent; radius: 8 * navigation.unit
+            color: rhine.state.dark ? "#929b83" : "#a2aa8d"
+            opacity: row.selected ? 0.24 : pointer.containsMouse ? 0.14 : 0
+            Behavior on opacity { NumberAnimation { duration: 110 } }
+        }
+        Text { x: 10 * navigation.unit; anchors.verticalCenter: parent.verticalCenter; text: row.icon; font.pixelSize: 19 * navigation.typeUnit; color: rhine.state.dark ? "#eeeee8" : "#43473d" }
+        Text { x: 38 * navigation.typeUnit; width: parent.width - x - 4 * navigation.unit; anchors.verticalCenter: parent.verticalCenter; text: row.label; font.pixelSize: 16 * navigation.typeUnit; elide: Text.ElideRight; color: rhine.state.dark ? "#eeeee8" : "#30342d" }
+        MouseArea { id: pointer; anchors.fill: parent; hoverEnabled: true; cursorShape: Qt.PointingHandCursor; onClicked: row.invoked() }
+    }
+}
diff --git a/Qt/qml/UserProfile.qml b/Qt/qml/UserProfile.qml
new file mode 100644
index 0000000..f183c29
--- /dev/null
+++ b/Qt/qml/UserProfile.qml
@@ -0,0 +1,214 @@
+import QtQuick
+
+Rectangle {
+    id: page
+    objectName: "userProfilePage"
+    property real unit: 1
+    property var hudState: rhine.state
+    property var person: hudState.profile || ({})
+    readonly property color ink: hudState.dark ? "#eeeee6" : "#25291f"
+    readonly property color muted: hudState.dark ? "#a0a495" : "#75796b"
+    readonly property color accent: hudState.dark ? "#bac39b" : "#777b60"
+    readonly property color shade: hudState.dark ? "#30362b" : "#e1e1d7"
+    color: hudState.dark ? "#22261f" : "#eeece4"
+    clip: true
+    MouseArea {
+        anchors.fill: parent; hoverEnabled: true
+        onPositionChanged: function(mouse) { var p = mapToItem(null, mouse.x, mouse.y); rhine.hoverItem("", p.x / page.unit, p.y / page.unit); }
+        onWheel: function(event) { event.accepted = true; }
+    }
+    function cover(url) { return String(url || "").replace(/^http:/, "https:"); }
+    function hoverCard(index, item, mouse) {
+        var p = item.mapToItem(null, mouse.x, mouse.y);
+        rhine.hoverItem("profile:item:" + index, p.x / page.unit, p.y / page.unit);
+    }
+    function navigateKey(key) {
+        var rows = page.hudState.profileRows || [];
+        if (!rows.length) { return; }
+        var action = String(page.hudState.focusAction || "");
+        var index = action.indexOf("profile:item:") === 0 ? Number(action.split(":")[2]) : -1;
+        if (key === "Enter") { if (index >= 0) rhine.action("profile:item:" + index); return; }
+        var columns = cards.columns;
+        var movement = key === "ArrowDown" ? columns : key === "ArrowUp" ? -columns : key === "ArrowRight" ? 1 : key === "ArrowLeft" ? -1 : 0;
+        if (!movement) { return; }
+        index = index < 0 ? 0 : Math.max(0, Math.min(rows.length - 1, index + movement));
+        rhine.action("profile:focus:" + index);
+        var card = cardRepeater.itemAt(index);
+        if (card) {
+            var y = card.mapToItem(content, 0, 0).y;
+            if (y < reading.contentY) reading.contentY = y;
+            else if (y + card.height > reading.contentY + reading.height) reading.contentY = y + card.height - reading.height;
