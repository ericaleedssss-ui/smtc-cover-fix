+                                    font.family: rhineFontFamily
+                                    font.pixelSize: 15 * page.unit
+                                    color: page.muted
+                                }
+                                MouseArea {
+                                    anchors.fill: parent
+                                    cursorShape: Qt.PointingHandCursor
+                                    onClicked: rhine.action("music:recommend-playlist:" + card.index)
+                                }
+                            }
+                            Text {
+                                objectName: "recommendationPlaylistTitle"
