+void NativeHud::songHeart(QJsonObject song, double x, double y, const QString &action) {
+    if(song["kind"]!="song")return;
+    const bool liked=m_music->likedIDs ? MusicData::indexOf(*m_music->likedIDs,song["id"])>=0 : MusicData::indexOfId(m_music->lists[1],song["id"].toString())>=0;
+    const QString path="M 12 21 C 7 17 2 13 2 7 C 2 1 9 0 12 6 C 15 0 22 1 22 7 C 22 13 17 17 12 21 Z";
+    const QJsonArray color=liked?QJsonArray{.808,.341,.357,1}:QJsonArray{.573,.584,.549,1};
+    save();translate(x,y);scale(20./24.,20./24.);
+    if(liked)op({"fill-path",path,color});else op({"path",path,1.65,color,QJsonArray{},0});
+    restore();
+    if(!m_music->writeLoading&&m_music->canMutate("/like"))hit(x-6,y-6,32,32,action,liked?"取消喜欢":"喜欢");
+}
